# ============================================================
# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，不会入库。
# 所有变量统一前缀 AUTOTEST_，框架只读这一组变量。
# ============================================================

# 被测目标：stub = 内置契约桩（离线可跑）；real = 真实 RuoYi 后端
AUTOTEST_TARGET=stub

# 真实后端地址（AUTOTEST_TARGET=real 时生效）
AUTOTEST_BASE_URL=http://localhost:8080

# 测试账号。真实的超级管理员口令不要提交到仓库
AUTOTEST_ADMIN_USER=admin
AUTOTEST_ADMIN_PASS=admin123

# 后端是否开启验证码。true 时框架会走 /captchaImage 取 uuid，
# 再从 Redis（或桩的 /__stub/captcha/{uuid}）取真实验证码
AUTOTEST_CAPTCHA_ENABLED=false

# 验证码取值的三条路，按顺序尝试（详见 ruoyi/captcha.py）：
# 1) 直接给定固定验证码（测试环境把验证码固定成 1111 时最省事）
# 2) 桩专用调试接口（仅 AUTOTEST_TARGET=stub 可用）
# 3) 直连 Redis 读取 captcha_codes:{uuid}（真实 RuoYi 的正解）
AUTOTEST_CAPTCHA_CODE=
AUTOTEST_REDIS_URL=redis://localhost:6379/0

# 连接超时 / 读超时（秒）。不设超时是 CI 挂死的头号原因
AUTOTEST_HTTP_CONNECT_TIMEOUT=3
AUTOTEST_HTTP_READ_TIMEOUT=10

# 幂等请求（GET）失败重试次数
AUTOTEST_HTTP_RETRIES=2

# 并发跑用例时，每个 worker 使用独立数据命名空间
AUTOTEST_RUN_ID=

# 桩的端口，0 表示自动分配空闲端口
AUTOTEST_STUB_PORT=0

# 桩是否复现 RuoYi 3.8.x 的已知缺陷（true 时缺陷用例表现为 xfail）
AUTOTEST_STUB_REPRODUCE_BUGS=true

# 日志级别：DEBUG 会打印每个请求的完整报文
AUTOTEST_LOG_LEVEL=INFO

# ============================================================
# 以下变量只给 docker compose 用，测试框架不读取
# ============================================================

# RuoYi-Vue 源码根目录（含 pom.xml 与 sql/）。
# 默认 ../.. 对应"autotest/ 位于 RuoYi-Vue/ 下"的布局。
RUOYI_HOME=../..
